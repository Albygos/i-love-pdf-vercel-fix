{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(style\\.css|ad-manager\\.js|ads\\.txt|robots\\.txt|site\\.webmanifest|favicon\\.ico|favicon-.*\\.png|android-chrome-.*\\.png|apple-touch-icon\\.png|logo-branding\\.png|sitemap.*\\.xml|ads/.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    { "src": "/privacy-policy", "dest": "/privacy-policy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/cookie-policy", "dest": "/cookie-policy.html" },
    { "src": "/disclaimer", "dest": "/disclaimer.html" },
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/download/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
